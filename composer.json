{
    "name": "mgamadeus/ddd-common-political",
    "description": "Countries, languages, locales, political regions, states, localities for mgamadeus/ddd",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-political",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-political/issues",
        "source": "https://github.com/ddd-framework/ddd-political"
    },
    "version": "1.0.19",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd-argus": "^1.0",
        "mgamadeus/ddd": "^3.7.3"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\Political\\PoliticalModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
